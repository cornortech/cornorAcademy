generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator zod {
  provider = "prisma-zod-generator"
}

enum UserStatus {
  registered
  portalActivated
  portalDeactivated
  rejected
}

enum media {
  pdf
  video
  img
  code
  docx
  xlsx
  txt
  jpg
  png
  mp3
  mp4
  zip
  exe
  other
}

enum gender {
  male
  female
  other
}

enum category {
  WebDevelopment
  ui
  DataScience
  DigitalMarketing
}

enum language {
  nepali
  english
}

enum courseLevel {
  beginner
  intermediate
  advanced
}

enum courseStatus {
  upcoming
  active
  completed
}

enum courseEnrollStatus {
  requested
  approved
  rejected
}

enum paymentStatus {
  PENDING
  COMPLETED
  FAILED
}

model Student {
  id                 String            @id @default(uuid())
  uid                String            @unique
  name               String
  email              String            @unique
  phoneNumber        String            @unique
  gender             gender
  image              String
  dob                String
  address            String
  city               String
  district           String
  pincode            String
  country            String
  about              String
  educationInstitute String
  qualification      String
  isVerified         Boolean           @default(false)
  status             UserStatus        @default(registered)
  enrolledCourses    enrolledCourses[]
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt
  courseAgreement    courseAgreement[]
  payments           Payment[]
  certificates       Certificate[]
}

model Teacher {
  id                  String     @id @default(uuid())
  uid                 String     @unique
  name                String
  email               String     @unique
  image               String
  bio                 String
  noOfYearsExperience Int
  expertise           String
  dob                 String
  gender              gender
  isVerified          Boolean    @default(false)
  isApproved          Boolean    @default(false)
  status              UserStatus @default(registered)
  course              course[]
  createdAt           DateTime   @default(now())
  updatedAt           DateTime   @updatedAt
}

model Admin {
  id        String   @id @default(uuid())
  uid       String   @unique
  email     String   @unique
  name      String
  course    course[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model course {
  id               String             @id @default(uuid())
  teacherId        String?
  adminId          String
  title            String
  description      String
  requirements     String[]
  includes         String[]
  whatYouWillLearn String[]
  meetingUrl       String
  meetingTime      DateTime
  isOngoing        Boolean            @default(false)
  reminderSent     Boolean            @default(false)
  language         language
  level            courseLevel
  thumbnail        String
  category         category
  status           courseStatus       @default(upcoming)
  startDate        DateTime
  duration         Int
  price            Int
  teacher          Teacher?           @relation(fields: [teacherId], references: [id], onDelete: SetNull)
  admin            Admin              @relation(fields: [adminId], references: [id])
  enrolledCourses  enrolledCourses[]
  courseMedia      courseMedia[]
  announcements    announcement[]
  courseCurriculum courseCurriculum[]
  lessons          Lesson[]
  payments         Payment[]
  certificates     Certificate[]
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt
}

model courseCurriculum {
  id         String   @id @default(uuid())
  courseId   String
  title      String
  noOfLesson Int
  duration   Int
  content    String[]
  course     course   @relation(fields: [courseId], references: [id])
}

model Lesson {
  id         String    @id @default(uuid())
  courseId   String
  title      String
  videoUrl   String
  order      Int
  duration   Int
  course     course    @relation(fields: [courseId], references: [id])
  progresses Progress[]
  createdAt  DateTime  @default(now())
}

model enrolledCourses {
  id                  String             @id @default(uuid())
  studentId           String
  courseId            String
  paymentURL          String
  status              courseEnrollStatus @default(requested)
  rejectionReason     String?
  lastWatchedLessonId String?
  student             Student            @relation(fields: [studentId], references: [id], onDelete: Cascade)
  course              course             @relation(fields: [courseId], references: [id])
  progresses          Progress[]
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt
}

model Progress {
  id             String         @id @default(uuid())
  lessonId       String
  enrollmentId   String
  completed      Boolean        @default(false)
  completedAt    DateTime?
  lesson         Lesson         @relation(fields: [lessonId], references: [id])
  enrollment     enrolledCourses @relation(fields: [enrollmentId], references: [id])
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
}

model Payment {
  id            String        @id @default(uuid())
  studentId     String
  courseId      String
  amount        Float
  provider      String
  status        paymentStatus @default(PENDING)
  transactionId String?
  student       Student       @relation(fields: [studentId], references: [id])
  course        course        @relation(fields: [courseId], references: [id])
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
}

model Certificate {
  id          String   @id @default(uuid())
  studentId   String
  courseId    String
  url         String
  certId      String   @unique
  student     Student  @relation(fields: [studentId], references: [id])
  course      course   @relation(fields: [courseId], references: [id])
  issuedAt    DateTime @default(now())
}

model courseMedia {
  id          String       @id @default(uuid())
  courseId    String
  title       String
  description String
  duration    Int?
  pathURL     String
  size        Int
  type        media
  course      course       @relation(fields: [courseId], references: [id], onDelete: Cascade)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
}

model announcement {
  id        String   @id @default(uuid())
  courseId  String
  title     String
  message   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  course    course   @relation(fields: [courseId], references: [id])
}

model courseAgreement {
  id           String   @id @default(uuid())
  studentId    String
  agreementURL String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  student      Student  @relation(fields: [studentId], references: [id])
}

model VerificationToken {
  id        String   @id @default(uuid())
  email     String
  uid      String?
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([email])
  @@index([token])
}

model SystemSettings {
  id                 String   @id @default("system-settings-id")
  platformName       String   @default("Cornor Academy")
  supportEmail       String   @default("info@cornor.academy")
  supportPhone       String   @default("+977 9801234567")
  facebookUrl        String   @default("https://facebook.com/cornoracademy")
  instagramUrl       String   @default("https://instagram.com/cornor.academy")
  allowRefunds       Boolean  @default(true)
  requireCertificate Boolean  @default(true)
  autoArchive        Boolean  @default(false)
  currency           String   @default("npr")
  taxRate            Float    @default(0)
  updatedAt          DateTime @updatedAt
}
