# SERVER
PORT=4000

# FRONTEND URL (for redirects from backend)
FRONTEND_URL=http://localhost:3000

# DATABASE (PostgreSQL via Prisma)
DATABASE_URL=postgresql://postgres:your_password@localhost:5432/cornor_academy?schema=public

# CORS - Allowed Frontend Origins
WHITE_LISTED_ORIGINS=http://localhost:3000,https://cornor.academy

# DEFAULT ADMIN CREDENTIALS (for initial setup)
DEFAULT_ADMIN_EMAIL=admin@example.com
DEFAULT_ADMIN_PASSWORD=xxxxxxxxx

# FIREBASE ADMIN SDK (Service Account)
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-project.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_PRIVATE_KEY_HERE\n-----END PRIVATE KEY-----\n"
FIREBASE_STORAGE_BUCKET=your-project-id.appspot.com

# SMTP / EMAIL (Nodemailer)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
# Set to "true" for port 465 (SSL), "false" for port 587 (TLS/STARTTLS)
SMTP_SECURE=false
SMTP_USER=your-email@gmail.com
SMTP_PASS=your_app_password_here

# CLOUDINARY (File Uploads)
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

# KHALTI PAYMENT GATEWAY
KHALTI_SECRET_KEY=sk_test_xxxxxxxxx
KHALTI_BASE_URL=https://dev.khalti.com/api/v2
